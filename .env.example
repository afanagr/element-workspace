# ---------------------------------------------------------------------------
# Element Workspace - copy this file to .env and fill in at least one LLM key
# ---------------------------------------------------------------------------

# Port the whole application is served on (http://localhost:3000)
APP_PORT=3000
# Direct backend port (handy for debugging, nginx is the normal entry point)
BACKEND_PORT=8001

# Used to encrypt provider API keys at rest (Fernet/AES). Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-please-use-a-long-random-string

# Optional single-user bearer token. Empty = open single-user mode.
APP_USER_TOKEN=

# Postgres password (change for anything but local development)
POSTGRES_PASSWORD=workspace

# ------------------------------- LLM ---------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=

# Local fallback (docker compose --profile local-llm up -d, then:
#   docker compose exec ollama ollama pull llama3.2)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# --------------------------- Embeddings ------------------------------------
# openai | gemini | local | ollama
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---------------------------- Retrieval ------------------------------------
QDRANT_COLLECTION=workspace_documents
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RAG_TOP_K=6

# ----------------------------- Limits --------------------------------------
MAX_UPLOAD_MB=200
MAX_AGENT_STEPS=8
LLM_REQUEST_TIMEOUT=180
LLM_MAX_RETRIES=2
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --------------------------- Misc limits -----------------------------------
MAX_EXTRACT_FILES=2000
MAX_EXTRACT_MB=500
TESSERACT_LANG=eng+rus

# Leave empty when the UI is served by nginx on the same origin.
NEXT_PUBLIC_API_BASE=
