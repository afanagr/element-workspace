# ---------------------------------------------------------------------------
# Element Workspace - copy this file to .env and adjust the values below
# ---------------------------------------------------------------------------

# Port the whole application is served on (http://localhost:3000)
APP_PORT=3000
# OnlyOffice Document Server is proxied on this port (http://localhost:8081)
ONLYOFFICE_PORT=8081
# Direct backend port (handy for debugging, nginx is the normal entry point)
BACKEND_PORT=8001

# Used to encrypt provider API keys stored in the database (Fernet/AES). Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-please-use-a-long-random-string

# Bootstrap administrator. The account is created on the first start only -
# afterwards users are managed by the admin in /admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Login lifetime in hours (default: 14 days)
SESSION_TTL_HOURS=336

# Postgres password (change for anything but local development)
POSTGRES_PASSWORD=workspace

# ---------------------- Legacy provider endpoints ---------------------------
# Chat models (address, key, model) are configured per account in /admin.
# These six values are read only by migration 0005, which imports credentials
# from pre-v2 releases; the running application ignores them. Delete them after
# the upgrade.
LLM_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# Local Qwen endpoint for the import: Ollama (http://host.docker.internal:11434/v1),
# vLLM (http://localhost:8000/v1) or any other OpenAI-compatible server.
QWEN_LOCAL_BASE_URL=
QWEN_LOCAL_MODEL=qwen2.5:7b-instruct

# --------------------------- OnlyOffice -------------------------------------
# Document Server replaces the built-in docx/xlsx/pptx/pdf/csv editors.
# Set ONLYOFFICE_ENABLED=false (or clear the URL/secret) to fall back to the
# legacy in-app viewers at any time. The full rollback point is the git tag
# "pre-onlyoffice".
ONLYOFFICE_ENABLED=true
# URL the browser uses to load the editor (host:ONLYOFFICE_PORT).
ONLYOFFICE_URL=http://localhost:8081
# Shared JWT secret: the same value is passed to the documentserver container.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
ONLYOFFICE_JWT_SECRET=
# How the Document Server container reaches this API for downloads/callbacks.
ONLYOFFICE_API_URL=http://backend:8000
# How this API reaches the Document Server for document conversion.
ONLYOFFICE_INTERNAL_URL=http://documentserver
# DOCX/XLSX/PPTX -> PDF conversion through the Document Server.
ONLYOFFICE_CONVERT_ENABLED=true
ONLYOFFICE_CONVERT_TIMEOUT=120
ONLYOFFICE_LANG=ru
# Extra hosts allowed in callback download URLs (public Document Server domains).
ONLYOFFICE_ALLOWED_HOSTS=documentserver,localhost,127.0.0.1

# --------------------------- Embeddings ------------------------------------
# Chat endpoints expose no embedding API, so vectors are always computed locally.
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---------------------------- Retrieval ------------------------------------
QDRANT_COLLECTION=workspace_documents
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RAG_TOP_K=6

# ----------------------------- Limits --------------------------------------
MAX_UPLOAD_MB=200
MAX_AGENT_STEPS=8
LLM_REQUEST_TIMEOUT=180
LLM_MAX_RETRIES=2
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --------------------------- Misc limits -----------------------------------
MAX_EXTRACT_FILES=2000
MAX_EXTRACT_MB=500
TESSERACT_LANG=eng+rus

# ------------------------- OCR (scanned PDFs) ------------------------------
# Pages without a text layer are rendered and recognised by Tesseract.
# Set OCR_PDF_ENABLED=false to disable automatic OCR during indexing.
OCR_PDF_ENABLED=true
# Empty = use TESSERACT_LANG above.
OCR_LANG=
OCR_DPI=300
OCR_MAX_PAGES=200
# A page is OCRed only when its text layer has fewer alphanumeric characters
# than this (a scanned page usually has none; a real page has many).
OCR_MIN_PAGE_CHARS=20
OCR_TIMEOUT_SECONDS=120
# Total OCR budget per document (seconds); pages left over are skipped so a
# huge scan cannot hit the 600 s proxy timeout.
OCR_BUDGET_SECONDS=540
OCR_DESKEW=true

# Leave empty when the UI is served by nginx on the same origin.
NEXT_PUBLIC_API_BASE=
