# ---------------------------------------------------------------------------
# Element Workspace - copy this file to .env and adjust the values below
# ---------------------------------------------------------------------------

# Port the whole application is served on (http://localhost:3000)
APP_PORT=3000
# Direct backend port (handy for debugging, nginx is the normal entry point)
BACKEND_PORT=8001

# Used to encrypt provider API keys stored in the database (Fernet/AES). Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-please-use-a-long-random-string

# Bootstrap administrator. The account is created on the first start only -
# afterwards users are managed by the admin in /admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Login lifetime in hours (default: 14 days)
SESSION_TTL_HOURS=336

# Postgres password (change for anything but local development)
POSTGRES_PASSWORD=workspace

# ------------------------- Legacy provider settings --------------------------
# Model connections (name, address, key, model) are configured per account in
# /admin. The variables below are only used by migration 0005 to convert
# credentials from older releases; the running application no longer reads them.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen cloud: Alibaba Cloud DashScope in OpenAI-compatible mode.
# DASHSCOPE_API_KEY is accepted as an alias for QWEN_API_KEY.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Qwen local: Ollama / vLLM / LM Studio / any OpenAI-compatible server.
# Leave QWEN_LOCAL_BASE_URL empty to disable the provider.
#   Ollama on the host:   http://localhost:11434/v1
#   Ollama from Docker:   http://host.docker.internal:11434/v1
#   vLLM:                 http://localhost:8000/v1
QWEN_LOCAL_BASE_URL=
QWEN_LOCAL_API_KEY=
QWEN_LOCAL_MODEL=qwen2.5:7b-instruct

# --------------------------- Embeddings ------------------------------------
# Chat providers expose no embeddings API here, so vectors are computed locally.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---------------------------- Retrieval ------------------------------------
QDRANT_COLLECTION=workspace_documents
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RAG_TOP_K=6

# ----------------------------- Limits --------------------------------------
MAX_UPLOAD_MB=200
MAX_AGENT_STEPS=8
LLM_REQUEST_TIMEOUT=180
LLM_MAX_RETRIES=2
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --------------------------- Misc limits -----------------------------------
MAX_EXTRACT_FILES=2000
MAX_EXTRACT_MB=500
TESSERACT_LANG=eng+rus

# Leave empty when the UI is served by nginx on the same origin.
NEXT_PUBLIC_API_BASE=
